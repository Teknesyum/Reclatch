<Window x:Class="Reclatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Reclatch"
        Width="880" Height="680" MinWidth="800" MinHeight="640"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBg}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36"
                        ResizeBorderThickness="7"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Surface}"
            BorderBrush="#3300F3FF" BorderThickness="0,0,0,1">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Path Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"
                Stroke="{StaticResource NeonBlue}" StrokeThickness="1.6"
                Data="M 2,4 L 14,4 L 14,14 L 2,14 Z M 4,8 L 8,8"/>
          <TextBlock x:Name="TitleText" Text="Reclatch"
                     FontFamily="{StaticResource FontSans}" FontSize="14" FontWeight="Bold"
                     Foreground="{StaticResource NeonBlue}" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Click="OnMinimize">
            <Path Width="10" Height="2" Stretch="Fill"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Data="M 0,0 L 10,0 L 10,2 L 0,2 Z"/>
          </Button>
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximize">
            <Path Width="11" Height="11" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                  Data="M 0.7,0.7 L 10.3,0.7 L 10.3,10.3 L 0.7,10.3 Z"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Click="OnClose">
            <Path Width="11" Height="11" Stretch="Uniform"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                  Data="M 0,0 L 11,11 M 11,0 L 0,11"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="Heading" Grid.Row="0" Style="{StaticResource H2}" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,24">
          <TextBlock x:Name="Intro" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
          <TextBlock x:Name="Purpose" Style="{StaticResource Hint}"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock x:Name="FramesLabel" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <TextBlock x:Name="FramesValue" Style="{StaticResource Hero}" Text="0"/>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock x:Name="ResolutionLabel" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <TextBlock x:Name="ResolutionValue" Style="{StaticResource MonoValue}" Text="—"/>
          </StackPanel>

          <StackPanel Grid.Column="2">
            <TextBlock x:Name="FpsLabel" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <TextBlock x:Name="FpsValue" Style="{StaticResource MonoValue}" Text="—"/>
          </StackPanel>
        </Grid>

        <TextBlock x:Name="AudioHeading" Grid.Row="3" Style="{StaticResource H3}" Margin="0,0,0,16"/>

        <Grid Grid.Row="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="220"/>
            <ColumnDefinition Width="*" MinWidth="200"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <CheckBox x:Name="SystemToggle" Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource NeonCheckBox}" VerticalAlignment="Center"
                    Margin="0,0,16,12" Checked="OnAudioToggled" Unchecked="OnAudioToggled"/>
          <ComboBox x:Name="SystemDevice" Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource NeonComboBox}" VerticalAlignment="Center"
                    Margin="0,0,16,12" DisplayMemberPath="Name"
                    SelectionChanged="OnDeviceChanged"/>
          <StackPanel x:Name="SystemMeter" Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="0,0,0,12"/>

          <CheckBox x:Name="MicToggle" Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource NeonCheckBox}" VerticalAlignment="Center"
                    Margin="0,0,16,0" Checked="OnAudioToggled" Unchecked="OnAudioToggled"/>
          <ComboBox x:Name="MicDevice" Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource NeonComboBox}" VerticalAlignment="Center"
                    Margin="0,0,16,0" DisplayMemberPath="Name"
                    SelectionChanged="OnDeviceChanged"/>
          <StackPanel x:Name="MicMeter" Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="5" VerticalAlignment="Bottom" Margin="0,24,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock x:Name="SystemFormatLabel" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <TextBlock x:Name="SystemFormatValue" Style="{StaticResource MonoValue}" Text="—"/>
          </StackPanel>

          <StackPanel Grid.Column="1">
            <TextBlock x:Name="MicFormatLabel" Style="{StaticResource Label}" Margin="0,0,0,8"/>
            <TextBlock x:Name="MicFormatValue" Style="{StaticResource MonoValue}" Text="—"/>
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,24,0,0">
          <Button x:Name="ToggleButton" Style="{StaticResource PrimaryButton}"
                  MinWidth="140" Click="OnToggleCapture"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="24,0,24,16">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="{StaticResource TextHint}"
                 VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="StateValue" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <Button x:Name="LanguageButton" Style="{StaticResource OutlineButton}"
                Padding="10,4" Click="OnToggleLanguage"/>
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="SupportButton" Style="{StaticResource OutlineButton}"
                Padding="10,4" Margin="0,0,12,0" Click="OnOpenSupport"/>
        <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource FontSans}" FontSize="14"
                   Foreground="{StaticResource NeonBlue}">
          <Hyperlink x:Name="SignatureLink" Click="OnOpenGithub"
                     Foreground="{StaticResource NeonBlue}" TextDecorations="None">Teknesyum</Hyperlink>
        </TextBlock>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
